# ─── RadAI Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── Security ─────────────────────────────────────────────────────────────────
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=radai
POSTGRES_USER=radai
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radai:change-me@localhost:5432/radai

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Orthanc ──────────────────────────────────────────────────────────────────
ORTHANC_URL=http://localhost:8042
ORTHANC_USER=orthanc
ORTHANC_PASSWORD=change-me

# ─── Ollama (Local LLM) ───────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=MedAIBase/MedGemma1.5:4b-it
OLLAMA_TIMEOUT=120

# ─── Cloud APIs (Optional — for Tier 2 report generation) ─────────────────────
OPENROUTER_API_KEY=sk-or-...
# Gemma 4 31B via OpenRouter (Tier 2 premium reports)
OPENROUTER_MODEL=google/gemma-4-31b-it

HF_TOKEN=hf_...
# MedGemma 1.5 4B via HuggingFace Inference API
HF_MEDGEMMA_MODEL=google/medgemma-1.5-4b-it

GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ─── Cloud GPU (Tier 3 segmentation) ──────────────────────────────────────────
CLOUD_GPU_URL=https://your-runpod-endpoint.runpod.io
CLOUD_GPU_API_KEY=change-me
CLOUD_GPU_AUTO_SHUTDOWN=true

# ─── Application ──────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Voice Dictation (faster-whisper) ─────────────────────────────────────────
# NOTE: MedASR CANNOT run via Ollama (needs audio input, not text API).
# faster-whisper handles audio → text natively in Python.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ─── Storage Paths ────────────────────────────────────────────────────────────
TEMP_PROCESSING_DIR=/tmp/radai-processing
REPORTS_DIR=./reports
MODELS_DIR=./backend/models
